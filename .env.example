# AmaniTrust environment template

# App
NODE_ENV=development
PORT=3000
APP_NAME=AmaniTrust

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amanitrust

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=3600s

# Encryption
FIELD_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LOOKUP_HASH_PEPPER=replace_with_strong_secret

# M-Pesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace_me
MPESA_CONSUMER_SECRET=replace_me
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace_me
MPESA_CALLBACK_URL=http://localhost:3000/api/v1/payments/mpesa/callback/stk
MPESA_B2C_TIMEOUT_URL=http://localhost:3000/api/v1/payments/mpesa/callback/b2c-timeout
MPESA_B2C_RESULT_URL=http://localhost:3000/api/v1/payments/mpesa/callback/b2c-result
MPESA_INITIATOR_NAME=replace_me
MPESA_SECURITY_CREDENTIAL=replace_me

# KYC
KYC_PROVIDER=simulated

# Blockchain
BLOCKCHAIN_NETWORK=development
